# =========================================================================
# CONFIGURACIÓN DE ENTORNO - ALVIS CRM
# =========================================================================
# Copia este archivo como .env y completa los valores necesarios.

# Puerto en el que correrá el servidor local de la aplicación
PORT=5173

# Host para enlazar el servidor (0.0.0.0 para acceso externo o localhost)
HOST=0.0.0.0

# -------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS (SUPABASE / POSTGRESQL)
# -------------------------------------------------------------------------
# Ejemplo: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# -------------------------------------------------------------------------
# CONEXIÓN A CACHÉ Y COLAS (REDIS)
# -------------------------------------------------------------------------
# Ejemplo: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# -------------------------------------------------------------------------
# AUTENTICACIÓN GOOGLE OAUTH 2.0 (INICIO DE SESIÓN EXCLUSIVO)
# -------------------------------------------------------------------------
# ID de cliente obtenido desde la Consola de Desarrolladores de Google.
GOOGLE_CLIENT_ID=

# -------------------------------------------------------------------------
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP - SALIDA)
# -------------------------------------------------------------------------
# Servidor SMTP (ej: smtp.gmail.com, smtp.office365.com)
SMTP_HOST=
# Puerto SMTP: 465 (SSL) o 587 (STARTTLS)
SMTP_PORT=465
# true para SSL (puerto 465), false para STARTTLS (puerto 587)
SMTP_SECURE=true
# Correo remitente
SMTP_USER=
# Contraseña o App Password
SMTP_PASS=
# Nombre que aparecerá como remitente
SMTP_FROM_NAME=Alvis CRM

# -------------------------------------------------------------------------
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (IMAP - ENTRADA) [OPCIONAL]
# -------------------------------------------------------------------------
# Servidor IMAP (ej: imap.gmail.com, outlook.office365.com)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
# Si se dejan vacíos, se usan SMTP_USER y SMTP_PASS
IMAP_USER=
IMAP_PASS=

# -------------------------------------------------------------------------
# CONTROL DE ACCESO Y CONFIGURACIÓN DE DOMINIO/WEBHOOKS
# -------------------------------------------------------------------------
# Permite o deniega el registro de múltiples usuarios mediante Google OAuth.
# Si es false, solo los usuarios registrados previamente en la base de datos
# (como el primer superusuario administrador) podrán iniciar sesión.
ALLOW_MULTIPLE_USERS=false

# URL pública o dominio de la aplicación (producción o desarrollo local).
# Se utiliza para autogenerar las URLs de Callback de los Webhooks en Meta
# y en el código del script del widget de Web Chat.
PUBLIC_URL=http://localhost:5173
